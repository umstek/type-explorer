{
  "name": "umstek-type-explorer",
  "displayName": "Type Explorer (Preview)",
  "description": "The missing object browser for vscode",
  "version": "0.2.1",
  "preview": true,
  "publisher": "umstek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/umstek/type-explorer"
  },
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "typeExplorer",
          "name": "Type Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "type-explorer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "type-explorer.showDocumentation",
        "title": "Show Documentation"
      },
      {
        "command": "type-explorer.browsePackage",
        "title": "Browse Package...",
        "icon": "$(package)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "type-explorer.refresh",
          "when": "view == typeExplorer",
          "group": "navigation"
        },
        {
          "command": "type-explorer.browsePackage",
          "when": "view == typeExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "npm-run-all2": "^9.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
